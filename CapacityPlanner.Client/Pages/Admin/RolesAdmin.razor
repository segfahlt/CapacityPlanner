@page "/rolesadmin"
@using Common.CapacityPlanner.Dto

@if (_loading)
{
	<MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2" />
}
else if (_error is not null)
{
	<MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
	<MudPaper Class="pa-3">
		<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
			<MudText Typo="Typo.subtitle1">Roles</MudText>
			<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate" Disabled="@_editing">Add</MudButton>
		</MudStack>

		@if (_editing)
		{
			<MudDivider Class="mb-2" />
			<MudForm>
				<MudStack Row Spacing="2" AlignItems="AlignItems.End" Class="mb-2">
					<MudTextField @bind-Value="_editName" Label="Name" Required="true" />
					<MudNumericField @bind-Value="_editDefaultUtilization" Label="Default Utilization (%)" Min="0" Max="100" Step="1" />
					<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
					<MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
				</MudStack>
			</MudForm>
		}

		<MudTable Items="_items" Hover="true" Dense="true">
			<HeaderContent>
				<MudTh>Name</MudTh>
				<MudTh>Default Utilization</MudTh>
				<MudTh></MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="Name">@context.Name</MudTd>
				<MudTd DataLabel="Default Utilization">@context.DefaultUtilizationTarget?.ToString("0.##")</MudTd>
				<MudTd>
					<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="@_editing" OnClick="() => StartEdit(context)" />
					<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Disabled="@_editing" OnClick="() => DeleteAsync(context)" />
				</MudTd>
			</RowTemplate>
		</MudTable>
	</MudPaper>
}