@using Common.CapacityPlanner.Dto

<MudStack Spacing="2">
	<MudAutocomplete T="LookupTypeDto" @bind-Value="SelectedType"
					 Label="Lookup Type" Variant="Variant.Outlined"
					 ToStringFunc="(t)=> t.DisplayName" Dense="true"
					 ResetValueOnEmptyText="true" Clearable="true"
					 SearchFunc="SearchTypes" CoerceText="true" CoerceValue="true" />

	@if (_selectedType is null)
	{
		<MudAlert Severity="Severity.Info">Select a lookup type to manage its items.</MudAlert>
	}
	else
	{
		<MudPaper Class="pa-3">
			<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
				<MudText Typo="Typo.subtitle1">@_selectedType.DisplayName</MudText>
				<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate" Disabled="@_editing">Add</MudButton>
			</MudStack>

			@if (_editing)
			{
				<MudDivider Class="mb-2" />
				<MudForm>
					<MudStack Row Spacing="2" AlignItems="AlignItems.End" Class="mb-2">
						<MudTextField @bind-Value="_editKey" Label="Key" Required="true" Disabled="@(!_isCreate)" />
						<MudTextField @bind-Value="_editDescription" Label="Description" />
						<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEdit">Save</MudButton>
						<MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
					</MudStack>
				</MudForm>
			}

			<MudTable Items="_items" Hover="true" Dense="true">
				<HeaderContent>
					<MudTh>Key</MudTh>
					<MudTh>Description</MudTh>
					<MudTh></MudTh>
				</HeaderContent>
				<RowTemplate>
					<MudTd DataLabel="Key">@context.Key</MudTd>
					<MudTd DataLabel="Description">@context.Description</MudTd>
					<MudTd>
						<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="@_editing" OnClick="() => StartEdit(context)" />
						<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Disabled="@_editing" OnClick="() => ConfirmDelete(context)" />
					</MudTd>
				</RowTemplate>
			</MudTable>
		</MudPaper>
	}
</MudStack>