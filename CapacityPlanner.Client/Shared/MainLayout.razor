@using MudBlazor
@inherits LayoutComponentBase
<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
	<MudAppBar Elevation="2">
		<MudText Typo="Typo.h6">Capacity Planner</MudText>
	</MudAppBar>

	<MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Persistent" Anchor="Anchor.Left" Class="pa-2">
		<PlatformNavMenu />
	</MudDrawer>

	<MudMainContent>
		<MudContainer Class="pa-4">
			@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>
<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>


