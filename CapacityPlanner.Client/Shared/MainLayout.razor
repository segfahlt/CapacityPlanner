@using MudBlazor
@using CapacityPlanner.Client.Shared

<MudLayout>
 <MudAppBar Elevation="2">
 <MudText Typo="Typo.h6">Capacity Planner</MudText>
 </MudAppBar>

 <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Persistent" Anchor="Anchor.Left" Class="pa-2" Style="width:320px;">
 <TreeNav />
 </MudDrawer>

 <MudMainContent>
 <MudContainer Class="pa-4">
 <Router AppAssembly="typeof(Program).Assembly">
 <Found Context="routeData">
 <RouteView RouteData="routeData" />
 </Found>
 <NotFound>
 <MudText>Sorry, there is nothing at this address.</MudText>
 </NotFound>
 </Router>
 </MudContainer>
 </MudMainContent>
</MudLayout>
